<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through Android cloud backup or device-to-device transfer:
     preferences hold the user's coordinates and prayer routine. Use the in-app settings file instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
